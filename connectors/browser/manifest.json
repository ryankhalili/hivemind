{
  "manifest_version": 3,
  "name": "HiveMind Browser",
  "version": "0.1.0",
  "description": "Connect a tab you choose to your HiveMind dashboard.",
  "permissions": ["activeTab", "scripting", "storage"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "action": {"default_popup": "popup.html", "default_title": "HiveMind"}
}
